{%- comment -%}
  sections/build-your-box.liquid
  Use on the product template "build-your-box".
  - Product has ONE option (Hamper). Each variant title looks like:
      "Cosmic Splendour - Blue Box (Add upto 8 items)"
    The max number of products is read from the variant title (number before "items").
  - Only products of the MAIN COLLECTION (section settings) are shown.
  - Filter chips: up to 10, each = custom name + collection. A chip shows only
    products that are in BOTH the main collection and that filter collection.
  - Customer can add 1 product up to the max of the selected variant (not required to fill the box).
{%- endcomment -%}

<section class="byb" id="byb-{{ section.id }}" data-product-id="{{ product.id }}">
  <style>
    .total_price{font-size:1.5rem}
    #byb-{{ section.id }}{--ink:{{ section.settings.text_color }};--paper:{{ section.settings.bg_color }};--accent:{{ section.settings.accent_color }};--line:{{ section.settings.border_color }};--mute:#000000;--ok:{{ section.settings.selected_color }};--r:14px;
      font-family:inherit;color:var(--ink);background:var(--paper);padding:48px 20px 80px}
    #byb-{{ section.id }} *{box-sizing:border-box}
    .byb__wrap{max-width:1280px;margin:0 auto}
    .byb__head{max-width:640px;margin-bottom:40px}
    .byb__head h1{font-size:clamp(2rem,4vw,3.25rem);line-height:1.05;margin:0 0 12px;font-weight:600;letter-spacing:-.02em}
    .byb__head p{margin:0;color:var(--mute);font-size:2.05rem;line-height:1.5}
    .byb__grid{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:48px;align-items:start}
    .byb__step{margin-bottom:56px}
    .byb__step h2{font-size:2rem;font-weight:600;margin:0 0 4px}
    .byb__step>p{margin:0 0 20px;color:var(--mute);font-size:1.5rem}
    .byb__opts{display:grid;gap:12px}
    .byb__opts--size{grid-template-columns:repeat(auto-fill,minmax(175px,1fr))}
    .byb__opts--items{grid-template-columns:repeat(auto-fill,minmax(190px,1fr))}
    .byb__card{position:relative;display:block;text-align:left;width:100%;background:var(--paper);color:var(--ink);
      border:1px solid var(--line);border-radius:var(--r);padding:0;cursor:pointer;font:inherit;transition:border-color .15s,box-shadow .15s;overflow:hidden}
    .byb__card:hover{border-color:#999}
    .byb__card:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
    .byb__card[aria-pressed="true"],.byb__card[aria-checked="true"]{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent)}
    .byb__card[disabled]{opacity:.45;cursor:not-allowed}
    .byb__img{aspect-ratio:1/1;background:#f4f4f4;display:block;width:100%;object-fit:cover}
    .byb__meta{padding:12px 14px 14px;display:flex;flex-direction:column;gap:2px}
    .byb__name{font-size:1.3rem;font-weight:500;line-height:1.3}
    .byb__price{font-size:1.2rem;color:var(--mute)}
    .byb__card--size .byb__meta{padding:16px}
    .byb__card--size .byb__name{font-size:1.5rem}
    .byb__card--size .byb__price{font-size:1.5rem;color:var(--ink);font-weight:600;margin-top:6px}
    .byb__tick{position:absolute;top:10px;right:10px;width:26px;height:26px;border-radius:50%;
      border:1.5px solid #bdbdbd;background:rgba(255,255,255,.9);display:grid;place-items:center;transition:all .15s}
    .byb__tick svg{width:14px;height:14px;stroke:#fff;fill:none;stroke-width:3;stroke-linecap:round;stroke-linejoin:round;opacity:0;transform:scale(.6);transition:all .15s}
    [aria-pressed="true"]>.byb__tick,[aria-checked="true"]>.byb__tick{background:#000;border-color:#000}
    [aria-pressed="true"]>.byb__tick svg,[aria-checked="true"]>.byb__tick svg{opacity:1;transform:scale(1)}
    .byb__tools{display:grid;gap:14px;margin-bottom:20px}
    .byb__tools-row{display:flex;gap:10px;flex-wrap:wrap}
    .byb__search{flex:1 1 240px;border:1px solid var(--line);border-radius:999px;padding:12px 18px;font:inherit;background:var(--paper);color:var(--ink)}
    .byb__search:focus{outline:2px solid var(--accent);outline-offset:1px}
    .byb__chips{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;scrollbar-width:thin}
    .byb__chip{flex:none;border:1px solid var(--line);background:var(--paper);color:var(--ink);border-radius:999px;padding:8px 16px;font:inherit;font-size:1rem;cursor:pointer;white-space:nowrap}
    .byb__chip[aria-pressed="true"]{background:var(--accent);color:var(--paper);border-color:var(--accent)}
    .byb__clear{background:none;border:0;font:inherit;text-decoration:underline;cursor:pointer;color:var(--mute)}
    .byb__results{font-size:.88rem;color:var(--mute)}
    .byb__more{display:block;margin:28px auto 0;border:1px solid var(--ink);background:var(--paper);color:var(--ink);border-radius:999px;padding:12px 28px;font:inherit;cursor:pointer}
    .byb__empty{grid-column:1/-1;color:var(--mute);padding:24px 0}
    .byb__sum{position:sticky;top:24px;border:1px solid var(--line);border-radius:var(--r);padding:24px}
    .byb__sum h3{margin:0 0 4px;font-size:2rem;font-weight:600}
    .byb__count{color:var(--mute);font-size:1rem;margin-bottom:16px}
    .byb__bar{height:4px;background:var(--line);border-radius:4px;overflow:hidden;margin-bottom:20px}
    .byb__bar i{display:block;height:100%;width:0;background:var(--accent);transition:width .25s}
    .byb__slots{list-style:none;margin:0 0 20px;padding:0;display:grid;gap:8px;max-height:340px;overflow:auto}
    .byb__slot{display:flex;align-items:center;gap:10px;font-size:1.1rem;min-height:44px;border:1px dashed var(--line);border-radius:10px;padding:4px 10px;color:var(--mute)}
    .byb__slot.is-on{border:1px solid var(--line);color:var(--ink)}
    .byb__slot img{width:36px;height:36px;border-radius:8px;object-fit:cover}
    .byb__slot span{flex:1;line-height:1.25}
    .byb__slot button{background:none;border:0;font-size:1.2rem;line-height:1;cursor:pointer;color:var(--mute);padding:6px}
    .byb__gift{margin:0 0 20px}
    .byb__gift label{display:block;font-weight:600;font-size:1.1rem;margin-bottom:8px}
    .byb__gift textarea{width:100%;min-height:96px;resize:vertical;border:1px solid var(--line);border-radius:12px;padding:12px 14px;font:inherit;background:var(--paper);color:var(--ink)}
    .byb__gift textarea:focus{outline:2px solid var(--accent);outline-offset:1px}
    .byb__gift small{display:block;text-align:right;color:var(--mute);font-size:.8rem;margin-top:4px}
    .byb__row{display:flex;justify-content:space-between;gap:12px;font-size:1.2rem;padding:6px 0}
    .byb__row span:last-child{text-align:right}
    .byb__row--total{font-weight:600;font-size:1.1rem;border-top:1px solid var(--line);margin-top:8px;padding-top:14px}
    .byb__cta{width:100%;margin-top:16px;background:var(--accent);color:var(--paper);border:0;border-radius:999px;padding:16px;font:inherit;font-weight:600;cursor:pointer;transition:opacity .15s}
    .byb__cta:disabled{opacity:.3;cursor:not-allowed}
    .byb__cta:not(:disabled):hover{opacity:.85}
    .byb__msg{font-size:.85rem;color:#b00020;min-height:1.2em;margin-top:10px}
    .byb__mbar{display:none}
    @media(max-width:960px){.byb__grid{grid-template-columns:1fr;gap:32px}.byb__sum{position:static}
      .byb__tick{width:30px;height:30px}.byb__tick svg{width:16px;height:16px}
      .byb__mbar{display:flex;align-items:center;gap:12px;position:fixed;left:0;right:0;bottom:0;z-index:50;background:var(--paper);
        border-top:1px solid var(--line);padding:12px 16px calc(12px + env(safe-area-inset-bottom,0px));box-shadow:0 -6px 20px rgba(0,0,0,.06);
        transition:transform .2s}
      .byb__mbar[hidden],.byb__mbar.is-away{transform:translateY(110%);pointer-events:none}
      .byb__mbar-main{flex:1;min-width:0}
      .byb__mbar-main strong{display:block;font-size:.95rem}
      .byb__mflash{display:block;font-size:.8rem;color:var(--ok);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-height:1.1em}
      .byb__mfill{height:3px;background:var(--line);border-radius:3px;overflow:hidden;margin-top:6px}
      .byb__mfill i{display:block;height:100%;width:0;background:var(--accent);transition:width .25s}
      .byb__mgo{flex:none;background:var(--accent);color:var(--paper);border:0;border-radius:999px;padding:12px 20px;font:inherit;font-weight:600;cursor:pointer}
      #byb-{{ section.id }}.has-mbar{padding-bottom:0px}}
    @media(max-width:520px){#byb-{{ section.id }}{padding:32px 16px 56px}.byb__opts--items{grid-template-columns:repeat(2,minmax(0,1fr))}.byb__opts--size{grid-template-columns:1fr}}
    @media(prefers-reduced-motion:reduce){#byb-{{ section.id }} *{transition:none!important}}
  </style>

  <div class="byb__wrap">
    <header class="byb__head">
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
    </header>

    <div class="byb__grid">
      <div>
        <div class="byb__step">
          <h2>Choose your hamper</h2>
          <p>The price updates with your selection.</p>
          <div class="byb__opts byb__opts--size" role="radiogroup" aria-label="Hamper" data-variants-ui></div>
        </div>

        <div class="byb__step">
          <h2>Pick your products</h2>
          <p data-hint>Select a hamper to start filling your box.</p>
          <div class="byb__tools">
            <div class="byb__tools-row">
              <input type="search" class="byb__search" placeholder="Search products" aria-label="Search products" data-q>
              <button type="button" class="byb__clear" data-clear hidden>Clear filters</button>
            </div>
            <div class="byb__chips" data-chips role="group" aria-label="Filters"></div>
            <div class="byb__results" data-results aria-live="polite">Loading products…</div>
          </div>
          <div class="byb__opts byb__opts--items" data-items></div>
          <button type="button" class="byb__more" data-more hidden>Show more</button>
        </div>
      </div>

      <aside class="byb__sum" aria-live="polite">
        <h3>Your box</h3>
        <div class="byb__count" data-count></div>
        <div class="byb__bar"><i data-bar></i></div>
        <ul class="byb__slots" data-slots></ul>
        {%- if section.settings.gift_enabled -%}
        <div class="byb__gift">
          <label for="gift-{{ section.id }}">{{ section.settings.gift_label }}</label>
          <textarea id="gift-{{ section.id }}" data-gift maxlength="{{ section.settings.gift_max }}" placeholder="{{ section.settings.gift_placeholder | escape }}"></textarea>
          <small><span data-gift-count>0</span>/{{ section.settings.gift_max }}</small>
        </div>
        {%- endif -%}
        <div class="byb__row"><span>Products Cost</span><span class="total_price" data-line-items>—</span></div>
        <div class="byb__row"><span>Box Cost</span><span data-line-box>—</span></div>
        <div class="byb__row byb__row--total"><span>Total</span><span data-total>—</span></div>
        <button type="button" class="byb__cta" data-cta disabled>Add box to cart</button>
        <div class="byb__msg" data-msg></div>
      </aside>
    </div>
  </div>

  {%- if section.settings.mobile_bar -%}
  <div class="byb__mbar" data-mbar aria-live="polite">
    <div class="byb__mbar-main">
      <strong data-mcount>0 selected</strong>
      <span class="byb__mflash" data-mflash></span>
      <div class="byb__mfill"><i data-mfill></i></div>
    </div>
    <button type="button" class="byb__mgo" data-goto>View box</button>
  </div>
  {%- endif -%}

  <script type="application/json" data-variants>
    [{% for v in product.variants %}{"id":{{ v.id }},"title":{{ v.option1 | json }},"price":{{ v.price }},"available":{{ v.available }},"img":{% if v.featured_media %}{{ v.featured_media.preview_image | image_url: width: 420 | json }}{% else %}""{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]
  </script>

  {%- comment -%} Main collection + filter chips (name + collection) from section settings {%- endcomment -%}
  <script type="application/json" data-main>{{ section.settings.main_collection.handle | json }}</script>
  <script type="application/json" data-cols>
    [{% for i in (1..10) %}{% assign ckey = 'filter_' | append: i | append: '_collection' %}{% assign lkey = 'filter_' | append: i | append: '_label' %}{% assign c = section.settings[ckey] %}{% assign l = section.settings[lkey] %}{% if c != blank %}{"handle":{{ c.handle | json }},"label":{% if l != blank %}{{ l | json }}{% else %}{{ c.title | json }}{% endif %}}{% else %}null{% endif %}{% unless forloop.last %},{% endunless %}{% endfor %}]
  </script>

  <script>
  (function(){
    var root=document.getElementById('byb-{{ section.id }}');
    var V=JSON.parse(root.querySelector('[data-variants]').textContent);
    var MAIN=JSON.parse(root.querySelector('[data-main]').textContent)||'';
    var COLS=JSON.parse(root.querySelector('[data-cols]').textContent).filter(Boolean);
    var $=function(s){return root.querySelector(s)};
    var fmt=function(p){return new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:0}).format(p/100)};

    /* max items is read from the variant title: "... (Add upto 8 items)" */
    V.forEach(function(v){
      var m=String(v.title).match(/upto\s*(\d+)/i)||String(v.title).match(/(\d+)\s*items?/i)||String(v.title).match(/(\d+)/);
      v.cap=m?parseInt(m[1],10):0;
      v.id=String(v.id);
    });
    var first=V.filter(function(v){return v.available})[0]||V[0];
    var st={vid:first?first.id:'',picked:[],q:'',col:'',shown:24};
    var ALL=[],FILTERED=[],MAP={},SELF='{{ product.handle }}';
    var esc=function(t){var d=document.createElement('div');d.textContent=t==null?'':t;return d.innerHTML.replace(/"/g,'&quot;')};
    var thumb=function(u){return u?u+(u.indexOf('?')>-1?'&':'?')+'width=420':''};
    var cv=function(){return V.filter(function(v){return v.id===st.vid})[0]};
    var cap=function(){var v=cv();return v?v.cap:0};
    var sumItems=function(){return st.picked.reduce(function(a,x){return a+(x.price||0)},0)};
    var tick='<span class="byb__tick" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>';

    function render(){
      var cur=cv(),max=cap(),n=st.picked.length;
      $('[data-variants-ui]').innerHTML=V.map(function(v){
        return '<button type="button" role="radio" class="byb__card byb__card--size" aria-checked="'+(v.id===st.vid)+'" data-vid="'+v.id+'"'+(v.available?'':' disabled')+'>'+tick+
          (v.img?'<img class="byb__img" src="'+esc(v.img)+'" alt="" loading="lazy">':'')+
          '<span class="byb__meta"><span class="byb__name">'+esc(v.title)+'</span><span class="byb__price">'+fmt(v.price)+'</span></span></button>';
      }).join('');
      var full=n>=max;
      root.querySelectorAll('[data-item]').forEach(function(el){
        var on=st.picked.some(function(x){return x.id===el.dataset.id});
        el.setAttribute('aria-pressed',on);
        el.disabled=full&&!on;
      });
      $('[data-hint]').textContent='Choose up to '+max+' products. '+(max-n)+' left.';
      $('[data-count]').textContent=n+' of '+max+' selected';
      var mc=$('[data-mcount]');
      if(mc){
        mc.textContent=n+' of '+max+' selected';
        $('[data-mfill]').style.width=(max?n/max*100:0)+'%';
        $('[data-goto]').textContent=n>0?'Review & add':'View box';
      }
      $('[data-bar]').style.width=(max?n/max*100:0)+'%';
      var slots='';
      for(var i=0;i<max;i++){
        var it=st.picked[i];
        slots+=it?'<li class="byb__slot is-on"><img src="'+esc(it.img)+'" alt=""><span>'+esc(it.title)+'</span><button type="button" data-remove="'+it.id+'" aria-label="Remove '+esc(it.title)+'">&times;</button></li>'
                  :'<li class="byb__slot">Add a treat</li>';
      }
      $('[data-slots]').innerHTML=slots;
      $('[data-line-items]').textContent=n?fmt(sumItems()):'—';
      $('[data-line-box]').textContent=cur?(cur.title+'  '+fmt(cur.price)):'—';
      $('[data-total]').textContent=cur?fmt(cur.price):'—';
      var ready=cur&&cur.available&&n>=1&&n<=max;
      var cta=$('[data-cta]');cta.disabled=!ready;
      cta.textContent=ready?'Add box to cart · '+fmt(cur.price):'Add at least 1 product to continue';
    }

    /* fetch all products of a collection (paginated) */
    function fetchCol(handle,cb){
      var page=1,out=[];
      (function next(){
        fetch('/collections/'+encodeURIComponent(handle)+'/products.json?limit=250&page='+page)
          .then(function(r){if(!r.ok)throw 0;return r.json()})
          .then(function(d){
            var ps=d.products||[];
            out=out.concat(ps);
            if(ps.length===250&&page<20){page++;next()}else cb(out);
          })
          .catch(function(){cb(out)});
      })();
    }

    function loadAll(){
      if(!MAIN){$('[data-results]').textContent='Please choose the main collection in the section settings.';return}
      /* 1) main collection = the only products allowed in the box */
      fetchCol(MAIN,function(ps){
        ps.forEach(function(p){
          if(p.handle===SELF)return;
          var id=String(p.id);
          if(MAP[id])return;
          var vs=p.variants||[];
          if(!vs.some(function(v){return v.available}))return;
          var price=Math.min.apply(null,vs.map(function(v){return parseFloat(v.price)}))*100;
          var o={id:id,title:p.title,img:thumb(p.images&&p.images[0]&&p.images[0].src),
            cols:[],vendor:p.vendor||'',price:price,
            hay:(p.title+' '+p.vendor+' '+p.product_type+' '+(Array.isArray(p.tags)?p.tags.join(' '):p.tags||'')).toLowerCase()};
          MAP[id]=o;ALL.push(o);
        });
        if(!ALL.length){$('[data-results]').textContent='No products found in the main collection.';return}
        /* 2) filter collections: only tag products already in main collection */
        var left=COLS.length;
        if(!left){buildFilters();applyFilters();return}
        COLS.forEach(function(c){
          fetchCol(c.handle,function(fp){
            fp.forEach(function(p){
              var e=MAP[String(p.id)];
              if(e&&e.cols.indexOf(c.handle)<0)e.cols.push(c.handle);
            });
            if(--left===0){buildFilters();applyFilters()}
          });
        });
      });
    }
    function buildFilters(){
      var chips=['<button type="button" class="byb__chip" data-col="" aria-pressed="true">All</button>'];
      COLS.forEach(function(c){
        var n=ALL.filter(function(p){return p.cols.indexOf(c.handle)>-1}).length;
        if(n)chips.push('<button type="button" class="byb__chip" data-col="'+esc(c.handle)+'" aria-pressed="false">'+esc(c.label)+' ('+n+')</button>');
      });
      $('[data-chips]').innerHTML=chips.join('');
    }
    function applyFilters(){
      var q=st.q.trim().toLowerCase().split(/\s+/).filter(Boolean);
      FILTERED=ALL.filter(function(p){
        return (!st.col||p.cols.indexOf(st.col)>-1)&&q.every(function(w){return p.hay.indexOf(w)>-1});
      });
      st.shown=24;renderItems();
    }
    function renderItems(){
      var list=FILTERED.slice(0,st.shown);
      $('[data-items]').innerHTML=list.length?list.map(function(p){
        return '<button type="button" class="byb__card" aria-pressed="false" data-item data-id="'+p.id+'" data-title="'+esc(p.title)+'" data-img="'+esc(p.img)+'" data-price="'+p.price+'">'+tick+
          (p.img?'<img class="byb__img" src="'+esc(p.img)+'" alt="'+esc(p.title)+'" loading="lazy" width="420" height="420">':'<span class="byb__img"></span>')+
          '<span class="byb__meta"><span class="byb__name">'+esc(p.title)+'</span><span class="byb__price">'+fmt(p.price)+'</span></span></button>';
      }).join(''):'<p class="byb__empty">No products match. Try a different search or clear the filters.</p>';
      $('[data-results]').textContent='Showing '+list.length+' of '+FILTERED.length+' products';
      $('[data-more]').hidden=FILTERED.length<=st.shown;
      $('[data-clear]').hidden=!(st.q||st.col);
      root.querySelectorAll('[data-col]').forEach(function(c){c.setAttribute('aria-pressed',c.dataset.col===st.col)});
      render();
    }
    var ft;
    function flash(m){var f=$('[data-mflash]');if(!f)return;f.textContent=m;clearTimeout(ft);ft=setTimeout(function(){f.textContent=''},2200);if(navigator.vibrate)try{navigator.vibrate(15)}catch(e){}}
    var mbar=$('[data-mbar]');
    if(mbar){root.classList.add('has-mbar');
      if('IntersectionObserver' in window)new IntersectionObserver(function(en){mbar.classList.toggle('is-away',en[0].isIntersecting)},{threshold:.25}).observe($('.byb__sum'))}
    var t;
    root.addEventListener('input',function(e){if(e.target.matches('[data-q]')){clearTimeout(t);t=setTimeout(function(){st.q=e.target.value;applyFilters()},200)}});

    root.addEventListener('click',function(e){
      var b;
      if(e.target.closest('[data-goto]')){$('.byb__sum').scrollIntoView({behavior:'smooth',block:'start'});return}
      if(e.target.closest('[data-more]')){st.shown+=24;renderItems();return}
      if(e.target.closest('[data-clear]')){st.q=st.col='';root.querySelector('[data-q]').value='';applyFilters();return}
      if((b=e.target.closest('[data-col]'))){st.col=b.dataset.col;applyFilters();return}
      if((b=e.target.closest('[data-vid]'))){st.vid=b.dataset.vid;st.picked=st.picked.slice(0,cap());render();return}
      if((b=e.target.closest('[data-item]'))){
        var i=st.picked.findIndex(function(x){return x.id===b.dataset.id});
        if(i>-1){st.picked.splice(i,1);flash('Removed · '+b.dataset.title)}
        else if(st.picked.length<cap()){st.picked.push({id:b.dataset.id,title:b.dataset.title,img:b.dataset.img,price:parseFloat(b.dataset.price)||0});flash('✓ Added · '+b.dataset.title+(st.picked.length===cap()?' · Box is full!':''))}
        render();return;
      }
      if((b=e.target.closest('[data-remove]'))){st.picked=st.picked.filter(function(x){return x.id!==b.dataset.remove});render();return}
      if(e.target.closest('[data-cta]'))addBox();
    });

    var gift=$('[data-gift]');
    if(gift)gift.addEventListener('input',function(){$('[data-gift-count]').textContent=gift.value.length});
    function openCartDrawer(){
      var sels=['[data-shopflow-cart]','a[href="/cart"]','a[href$="/cart"]','#cart-icon-bubble','button[aria-controls*="cart"]'];
      for(var i=0;i<sels.length;i++){
        var el=document.querySelector(sels[i]);
        if(el){el.click();return true}
      }
      return false;
    }
    function addBox(){
      var v=cv(),cta=$('[data-cta]'),msg=$('[data-msg]');
      if(!v||st.picked.length<1||st.picked.length>cap())return;
      var props={'Hamper':v.title};
      st.picked.forEach(function(it,i){props['Item '+(i+1)]=it.title});
      props['Products Total']=fmt(sumItems());
      if(gift&&gift.value.trim())props['Gift Message']=gift.value.trim();
      cta.disabled=true;cta.textContent='Adding…';msg.textContent='';
      fetch('{{ routes.cart_add_url }}.js',{method:'POST',headers:{'Content-Type':'application/json'},
        body:JSON.stringify({items:[{id:v.id,quantity:1,properties:props}]})})
        .then(function(r){if(!r.ok)throw r;return r.json()})
        .then(function(){
          if(!openCartDrawer()){window.location.href='{{ routes.cart_url }}'}
          render();
        })
        .catch(function(){msg.textContent='Could not add the box. Please try again.';render()});
    }
    render();loadAll();
  })();
  </script>
</section>

